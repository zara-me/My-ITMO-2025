@startuml
title Нажатие # в заблокированном состоянии: верный код
skinparam sequenceMessageAlign center
autonumber
participant "Пользователь" as U
participant "Клавиатура 3x4" as KB
participant "STM32 (main)" as MCU
participant "TM1637 (дисплей)" as TM
participant "Светодиоды PA9 / PA15" as LED
participant "USART2 (консоль)" as UART
U -> KB : нажатие #
KB --> MCU : readKey() возвращает #
alt is_unlocked == 0 и введённый код == current_pin
MCU -> LED : PA9 = 1 (зелёный ВКЛ), PA15 = 0
MCU -> UART : Access Granted! Enter new PIN and press #, or * to lock.
MCU -> MCU : is_unlocked = 1
MCU -> TM : отображение ---- (0x40 во всех разрядах)
MCU -> MCU : delay_ms(1000)
MCU -> TM : reset_input(): очистка дисплея
end
@enduml